# Copy to .env and fill in. NEVER commit .env with real secrets.
# Placeholders only — every value below must be replaced for a real deployment.

# --- Oracle XE container (gvenzl/oracle-xe) ---
# System password for SYS/SYSTEM inside the container (operator-chosen).
ORACLE_PASSWORD=change-me-sys-xxxx
# Pluggable database / service name (default XE layout).
ORACLE_DATABASE=XEPDB1

# --- Application schema owner (created inside Oracle by APP_USER_*) ---
# Used directly by the backend in compose; for local runs it is the XE user.
DB_USERNAME=labmarket
DB_PASSWORD=change-me-app-xxxx
# Local-run JDBC URL (host machine). Compose overrides the host to `oracle`
# for the backend container automatically — do not edit compose for this.
DB_URL=jdbc:oracle:thin:@localhost:1521/XEPDB1

# --- Backend (prod profile in compose; fails fast without these) ---
SPRING_PROFILES_ACTIVE=prod
JWT_SECRET=change-me-to-a-256-bit-secret-min-32-chars-long-xxxx
JWT_EXPIRATION_MS=3600000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Optional seeds (empty/disabled by default; set to opt in) ---
# First ADMIN account (created once at startup when both are set).
APP_ADMIN_USERNAME=
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=
APP_ADMIN_FULLNAME=Administrator
# Synthetic demo dataset: sample VENDOR + 10 instruments (dev/demo only).
APP_SEED_DEMO=false
APP_SEED_DEMO_VENDOR=demo-vendor
APP_SEED_DEMO_PASSWORD=

# --- Frontend ---
# API URL baked into the frontend image at build time (browser-facing address).
FRONTEND_API_URL=http://localhost:8080/api/v1
# Local `npm run dev` only (Vite reads this file directly, not compose).
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_APP_NAME=LabMarket

# NOTE: there is intentionally no SENSOR_API_KEY. Sensor devices authenticate
# per equipment item with a key provisioned via
# POST /api/v1/equipment/{id}/sensor-key (staff/admin) — a shared static key
# would be weaker and is deliberately not supported.
